# For more information, please see the README.md

# Required: Suno authentication cookie
SUNO_COOKIE=

# Required: 2Captcha API key (obtain from 2captcha.com)
TWOCAPTCHA_KEY=

# Browser configuration
BROWSER=chromium # `chromium` or `firefox`, although `chromium` is highly recommended
BROWSER_GHOST_CURSOR=false
BROWSER_LOCALE=en
BROWSER_HEADLESS=true
BROWSER_DISABLE_GPU=false # Set to true for Docker environments

# Optional: Rate limiting (requires Upstash Redis)
# Sign up at https://upstash.com for free tier
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: CORS configuration (comma-separated allowed origins)
# Leave empty or set to * for development, specify domains for production
ALLOWED_ORIGINS=

# Optional: Logging level
LOG_LEVEL=info # debug, info, warn, error

# Optional: Node environment
NODE_ENV=development # development, production, test